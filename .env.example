# Optional. When set, every enquiry is POSTed here as JSON (CRM or email webhook).
CRM_WEBHOOK_URL=
# PostgreSQL for the consoles and website content. Leave empty to use the embedded local database in web/.data (development only).
DATABASE_URL=
# Any long random string; signs console login cookies.
SESSION_SECRET=
# Optional. Secret for the scheduled-campaign cron endpoint (POST /api/campaigns/run with header x-cron-secret).
CRON_SECRET=
# Optional. Public base URL Meta uses to fetch campaign attachments (defaults to the site url in src/data/site.ts).
PUBLIC_URL=
# The two admin accounts (equal authority). Each is created once on first start with this temporary password,
# which must be changed at first sign-in. Manav's account takes over the seeded demo admin.
ADMIN_MANAV_EMAIL=manav@your-domain.com
ADMIN_MANAV_TEMP_PASSWORD=
ADMIN_KOMAL_EMAIL=komal@your-domain.com
ADMIN_KOMAL_TEMP_PASSWORD=
